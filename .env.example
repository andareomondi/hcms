# HCMS environment configuration.
#
# Setup:
#   cp .env.example .env
#   then replace every value marked CHANGE ME.
#
# Never commit the real .env file. It is listed in .gitignore.

# ---- Django -----------------------------------------------------------
# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-long-random-key

# True for local development only. Must be False on any server that real users reach.
DJANGO_DEBUG=True

# True to allow staff registration. Must be False on any server that real users reach.
ALLOW_STAFF_REGISTRATION = False

# Comma-separated. Add your ngrok or server hostname here.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated, full URLs with scheme. Leave empty for local development without a tunnel.
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- PostgreSQL -------------------------------------------------------
DB_NAME=hospital_cms
DB_USER=hcms_app
DB_PASSWORD=CHANGE-ME
DB_HOST=127.0.0.1
DB_PORT=5432
