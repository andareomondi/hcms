# HCMS environment configuration.
#
# Setup:
#   cp .env.example .env
#   then replace every value marked CHANGE ME and adjust for your environment.
#
# Never commit the real .env or .env.production file. They are listed in .gitignore.
#
# Scenario guide:
#   1. Local HTTP (runserver over http://127.0.0.1:8000):
#      - DJANGO_DEBUG=True
#      - DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
#      - DJANGO_CSRF_TRUSTED_ORIGINS= (empty)
#      - DJANGO_SECURE_SSL_REDIRECT=False
#      - DJANGO_SESSION_COOKIE_SECURE=False
#      - DJANGO_CSRF_COOKIE_SECURE=False
#      - DJANGO_SECURE_HSTS_SECONDS=0
#      - DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
#      - DJANGO_SECURE_HSTS_PRELOAD=False
#
#   2. Local HTTPS tunnel (e.g., ngrok -> http://127.0.0.1:8000):
#      - Add your ngrok hostname to DJANGO_ALLOWED_HOSTS
#      - Add https://<your-tunnel-host> to DJANGO_CSRF_TRUSTED_ORIGINS
#      - Keep DJANGO_SECURE_SSL_REDIRECT=False unless X-Forwarded-Proto is always set
#      - Set DJANGO_SESSION_COOKIE_SECURE=True and DJANGO_CSRF_COOKIE_SECURE=True
#
#   3. Production over HTTPS (e.g., Render, Nginx + Gunicorn):
#      - Generate a strong, unique DJANGO_SECRET_KEY (never reuse dev/sample keys)
#      - Set DJANGO_DEBUG=False and ALLOW_STAFF_REGISTRATION=False
#      - Set DJANGO_ALLOWED_HOSTS and DJANGO_CSRF_TRUSTED_ORIGINS to your live domain(s)
#      - Set DJANGO_SECURE_SSL_REDIRECT=True
#      - Set DJANGO_SESSION_COOKIE_SECURE=True and DJANGO_CSRF_COOKIE_SECURE=True
#      - Set DJANGO_SECURE_HSTS_SECONDS=3600 (verify TLS first, then raise to 31536000)
#      - Set DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True (only if all subdomains use HTTPS)
#      - Set a strong production DB_PASSWORD and live DB_HOST

# ---- Django -----------------------------------------------------------
# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Production: must be a unique, high-entropy secret never used in dev or committed.
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-long-random-key

# True for local development only. Must be False on any server that real users reach.
DJANGO_DEBUG=True

# True to allow staff registration. Must be False on any server that real users reach.
ALLOW_STAFF_REGISTRATION=False

# Comma-separated hostnames/IPs Django will serve.
# Local HTTP: localhost,127.0.0.1,[::1]
# Tunnel / Production: append your ngrok host or live domain (e.g. hcms.example.com).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],proton-absurd-portside.ngrok-free.dev,hcms-cksr.onrender.com

# Comma-separated full origins with scheme (https://...) required for HTTPS/tunnels.
# Local HTTP: leave empty.
# Tunnel / Production: include every https:// origin users access (e.g. https://hcms.example.com).
DJANGO_CSRF_TRUSTED_ORIGINS=https://proton-absurd-portside.ngrok-free.dev,https://hcms-cksr.onrender.com

# Redirect HTTP requests to HTTPS.
# Local HTTP: False | Local tunnel: False (or True only if proxy always sends X-Forwarded-Proto: https)
# Production over HTTPS: True
DJANGO_SECURE_SSL_REDIRECT=False

# Mark session and CSRF cookies as Secure (sent over HTTPS only).
# Local HTTP: False (browsers may block Secure cookies on plain HTTP)
# Local HTTPS tunnel & Production over HTTPS: True
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# HSTS max-age in seconds (0 disables).
# Local HTTP / tunnel: 0
# Production over HTTPS: start with 3600 to verify TLS, then raise to 31536000 (1 year).
DJANGO_SECURE_HSTS_SECONDS=3600

# Apply HSTS to subdomains when serving over HTTPS.
# Local HTTP / tunnel: False | Production over HTTPS: True (only if all subdomains support HTTPS)
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Only set True if intentionally submitted to browser HSTS preload lists.
DJANGO_SECURE_HSTS_PRELOAD=False

# ---- PostgreSQL -------------------------------------------------------
# Production: use a dedicated database, strong password, and production host/port.
DB_NAME=hospital_cms
DB_USER=hcms_app
DB_PASSWORD=CHANGE-ME
DB_HOST=127.0.0.1
DB_PORT=5432
